[Unit]
Description=Trading Ecosystem Monitor
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/trading_ecosystem
EnvironmentFile=/opt/trading_ecosystem/.env
Environment=DATA_DIR=/opt/trading_ecosystem/data
ExecStart=/opt/trading_ecosystem/.venv/bin/te-monitor --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
