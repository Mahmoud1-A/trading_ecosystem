# Alpaca Paper Trading — keep this file local; never commit real secrets.
# After copy:  copy .env.example .env
# Then paste keys from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DATA_DIR=data
LOG_LEVEL=INFO
# Required for start/stop from the web control panel (/control)
CONTROL_TOKEN=
# true on laptop; false on trade-only Droplet
ALLOW_DISCOVERY_CONTROL=true
DISCOVERY_UNIVERSE=etf
